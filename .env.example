# Local settings. Copy to .env (gitignored) and change what you need:
#   cp .env.example .env
# This file is public: sample values only, never a secret. Variables already set in your shell
# win over .env. Read by `pnpm dev`, `pnpm build`, `pnpm start`, `pnpm test:e2e` and
# `pnpm compose`. Deployed environments don't use it: Cloud Run gets its config from the service
# and Secret Manager (architecture §7).

# Dev server port (`pnpm dev`, `vite preview`). 7877 spells PUPP on a phone keypad.
DEV_PORT=7877

# MongoDB, which must be a replica set. `pnpm compose up -d --wait` starts one on
# MONGO_PORT; keep the port in MONGODB_URI the same.
MONGO_PORT=27017
MONGODB_URI=mongodb://localhost:27017/?directConnection=true
MONGODB_DB=toe-beans

# The app image from `pnpm compose --profile app up --build -d --wait`.
APP_PORT=3000

# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Sentry reporting is off unless a DSN is set. Leave it unset locally.
# SENTRY_DSN=

# OIDC Sign-in
OIDC_ISSUER=https://toe-beans-dev.eu.auth0.com/
OIDC_CLIENT_ID=Auth0_App_Client_Id
OIDC_CLIENT_SECRET=Auth0_App_Client_Secret
PUBLIC_BASE_URL=http://localhost:7877
# Sign-in (architecture §3.4). Unset, the app uses the mock OIDC provider that `pnpm compose up`
# starts on localhost:8090, where any subject and claims sign you in. To use the Auth0 dev tenant,
# set all three from docs/runbooks/auth0.md; the client secret goes in .env only, never here.
# OIDC_ISSUER=https://toe-beans-dev.eu.auth0.com/
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=

# The origin you open the app on; callback URLs and the cross-site check derive from it. Change it
# for `pnpm dev --host` on a phone (e.g. http://192.168.1.20:7877) and register the callback with
# the provider. Defaults to http://localhost:7877.
# PUBLIC_BASE_URL=http://localhost:7877
