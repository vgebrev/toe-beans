{
	"id": "/",
	"name": "Toe Beans",
	"short_name": "Toe Beans",
	"description": "Puppy training and care for the whole household.",
	"start_url": "/",
	"scope": "/",
	"display": "standalone",
	"launch_handler": {
		"client_mode": ["navigate-existing", "auto"]
	},
	"orientation": "portrait",
	"background_color": "#FFFBF5",
	"theme_color": "#FFFBF5",
	"icons": [
		{
			"src": "/icons/icon-192.png",
			"sizes": "192x192",
			"type": "image/png",
			"purpose": "any"
		},
		{
			"src": "/icons/icon-512.png",
			"sizes": "512x512",
			"type": "image/png",
			"purpose": "any"
		},
		{
			"src": "/icons/maskable-192.png",
			"sizes": "192x192",
			"type": "image/png",
			"purpose": "maskable"
		},
		{
			"src": "/icons/maskable-512.png",
			"sizes": "512x512",
			"type": "image/png",
			"purpose": "maskable"
		}
	],
	"shortcuts": [
		{
			"name": "Log training",
			"short_name": "Log training",
			"description": "Log a practice, planned or not",
			"url": "/?add=log",
			"icons": [
				{
					"src": "/icons/shortcut-log-96.png",
					"sizes": "96x96",
					"type": "image/png"
				}
			]
		},
		{
			"name": "Record event",
			"short_name": "Record event",
			"description": "Barking, a visitor, an accident…",
			"url": "/?add=event",
			"icons": [
				{
					"src": "/icons/shortcut-event-96.png",
					"sizes": "96x96",
					"type": "image/png"
				}
			]
		}
	]
}
