{
	"name": "@toe-beans/web",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc --noEmit -p src/service-worker",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"start": "node --env-file-if-exists=../../.env build",
		"test:e2e": "playwright test",
		"icons": "node scripts/icons.mjs",
		"vapid": "node scripts/vapid.mjs"
	},
	"devDependencies": {
		"@fontsource-variable/fredoka": "~5.3.0",
		"@fontsource-variable/nunito": "~5.3.0",
		"@hugeicons/core-free-icons": "~4.3.5",
		"@internationalized/date": "^3.12.4",
		"@playwright/test": "~1.64.1",
		"@sentry/browser": "^11.10.0",
		"@sveltejs/adapter-node": "6.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "~4.3.3",
		"@toe-beans/backend": "workspace:*",
		"@toe-beans/contracts": "workspace:*",
		"bits-ui": "~2.20.2",
		"clsx": "^2.1.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"tailwind-merge": "~3.7.0",
		"tailwind-variants": "~3.3.1",
		"tailwindcss": "~4.3.3",
		"tw-animate-css": "~1.4.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"zod": "^4.6.7"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@opentelemetry/api": "^1.10.0",
		"sharp": "^0.35.5"
	}
}
